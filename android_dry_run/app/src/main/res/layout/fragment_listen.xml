<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/screen_top_bar_height"
        android:background="@color/surface_white"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/Text.VoxGest.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/title_listen" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="16dp"
            android:src="@drawable/ic_settings" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/speechCard"
        android:layout_width="0dp"
        android:layout_height="136dp"
        android:layout_marginStart="@dimen/card_margin_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/card_margin_h"
        app:cardBackgroundColor="@color/listen_card_bg"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <TextView
                android:id="@+id/speechLabel"
                style="@style/Text.VoxGest.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/label_speech_transcript"
                app:layout_constraintEnd_toStartOf="@id/speechSpeakerButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/speechSpeakerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_replay"
                android:padding="11dp"
                android:src="@drawable/ic_volume_up"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/responseText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppins"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="4"
                android:text="@string/speech_sample"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_speech_transcript"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/speechLabel" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/micArea"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="@dimen/card_margin_h"
        android:layout_marginEnd="@dimen/card_margin_h"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/speechCard">

        <com.voxgest.app.views.WaveformView
            android:id="@+id/waveformLeft"
            android:layout_width="78dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="@id/micButton"
            app:layout_constraintEnd_toStartOf="@id/micButton"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/micButton" />

        <FrameLayout
            android:id="@+id/micButton"
            android:layout_width="@dimen/mic_button_size"
            android:layout_height="@dimen/mic_button_size"
            android:background="@drawable/bg_mic_circle_light"
            android:clickable="true"
            android:contentDescription="@string/cd_mic"
            android:elevation="6dp"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/micStatusText"
            app:layout_constraintEnd_toStartOf="@id/waveformRight"
            app:layout_constraintStart_toEndOf="@id/waveformLeft"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@android:color/white" />
        </FrameLayout>

        <com.voxgest.app.views.WaveformView
            android:id="@+id/waveformRight"
            android:layout_width="78dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="@id/micButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/micButton"
            app:layout_constraintTop_toTopOf="@id/micButton" />

        <TextView
            android:id="@+id/micStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:text="@string/listen_status_active"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_status"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/micSubtext"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/micButton" />

        <TextView
            android:id="@+id/micSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:text="@string/listen_subtext"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/micStatusText" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/avatarPanel"
        android:layout_width="0dp"
        android:layout_height="@dimen/avatar_card_height"
        android:layout_marginStart="@dimen/card_margin_h"
        android:layout_marginEnd="@dimen/card_margin_h"
        app:cardBackgroundColor="@color/card_surface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/micArea">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/avatarLabel"
                style="@style/Text.VoxGest.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:text="@string/label_avatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_analyzing_badge"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/avatar_analyzing"
                android:textColor="@color/primary_teal"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/avatarStage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_avatar_gradient"
                app:layout_constraintBottom_toTopOf="@id/avatarSequenceText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/avatarLabel">

                <com.voxgest.app.avatar.AvatarView
                    android:id="@+id/avatarView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/avatarSequenceText"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:background="@color/surface_white"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/avatar_caption"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/phraseMatchLabel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/playButtonsRow"
        android:layout_width="0dp"
        android:layout_height="@dimen/play_button_height"
        android:layout_marginStart="@dimen/card_margin_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/card_margin_h"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatarPanel">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/replayButton"
            style="@style/Widget.VoxGest.ActionButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:contentDescription="@string/cd_replay"
            android:text="@string/action_replay"
            android:textColor="@color/primary_teal"
            app:backgroundTint="@color/surface_white"
            app:cornerRadius="@dimen/btn_radius"
            app:icon="@drawable/ic_replay"
            app:iconTint="@color/primary_teal"
            app:strokeColor="@color/primary_teal"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playSignsButton"
            style="@style/Widget.VoxGest.ActionButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:contentDescription="@string/cd_play_signs"
            android:text="@string/action_play_signs"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/primary_teal"
            app:cornerRadius="@dimen/btn_radius"
            app:icon="@drawable/ic_play_arrow"
            app:iconTint="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
