<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/phrasesScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/phrasesRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/screen_top_bar_height"
            android:background="@color/surface_white"
            android:elevation="2dp">

            <TextView
                style="@style/Text.VoxGest.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/title_phrases" />

            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_search"
                android:padding="16dp"
                android:src="@drawable/ic_search" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_height"
            android:layout_marginStart="@dimen/card_margin_h"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/card_margin_h"
            app:cardBackgroundColor="@color/primary_teal"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_quick_phrases"
                android:padding="20dp">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:includeFontPadding="false"
                    android:text="@string/quick_phrases"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/heroIconCircle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/heroSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.86"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/quick_phrases_subtitle"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/heroIconCircle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroTitle" />

                <FrameLayout
                    android:id="@+id/heroIconCircle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.92"
                    android:background="@drawable/bg_light_toggle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/primary_dark" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/dotIndicators"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_icon_teal" />
            <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="6dp" android:background="@drawable/bg_icon_yellow" />
            <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="6dp" android:background="@drawable/bg_icon_yellow" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/categoryScroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipEmergency"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/category_chip_height"
                    android:background="@drawable/bg_chip_emergency_light"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:text="⚠  Emergency"
                    android:textColor="@color/emergency_orange"
                    android:textSize="@dimen/text_category_chip"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipMedical"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/category_chip_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_medical_light"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:text="✚  Medical"
                    android:textColor="@color/medical_teal"
                    android:textSize="@dimen/text_category_chip"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipDaily"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/category_chip_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_soft_light"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:text="☀  Daily"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_category_chip"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipConversation"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/category_chip_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_soft_light"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:text="●  Conversation"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_category_chip"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/phrasesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
