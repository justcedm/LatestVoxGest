{
  "version": 1,
  "profile": "lightweight_visual_response_prototype",
  "purpose": "Simple cartoon avatar playback after confirmed token composition.",
  "disclaimer": "This is a lightweight visual response prototype, not a complete ASL avatar.",
  "input_contract": {
    "source": "confirmed token composer output only",
    "raw_predictions_allowed": false,
    "nothing_behavior": "no animation"
  },
  "renderer": {
    "style": "simple_2d_cartoon",
    "parts": ["head", "torso", "left_arm", "right_arm", "left_hand", "right_hand"],
    "keyframe_units": "normalized_screen_space",
    "time_units": "milliseconds"
  },
  "playback_rule": {
    "known_word": "play avatar/signs/<WORD>.json",
    "unknown_word": "fingerspell A-Z",
    "missing_animation": "clean placeholder fallback",
    "empty_animation": "clean placeholder fallback",
    "NOTHING": "ignore"
  },
  "known_words": {
    "YES": "signs/YES.json",
    "NO": "signs/NO.json",
    "HELLO": "signs/HELLO.json",
    "THANKYOU": "signs/THANKYOU.json",
    "WATER": "signs/WATER.json"
  },
  "phrase_intents": {
    "enabled": false,
    "note": "Phrase-level avatar responses are deferred until recognition hardening gates pass."
  }
}
