# VoxGest GitHub-safe ignore rules

# Python environments and caches
voxgest_env/
.venv/
venv/
env/
.conda/
.tox/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Android/Gradle generated output
**/.gradle/
**/.idea/
**/.kotlin/
**/build/
**/captures/
**/local.properties
**/keystore.properties
**/signing.properties
**/secrets.properties
**/google-services.json
*.jks
*.keystore
*.p12
*.pfx
*.pem
.env
.env.*
!.env.example
*.apk
*.aab
*.ap_
*.dex
*.hprof

