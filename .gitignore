# Keep small demo TFLite files, manifests, and labels available for review.
!model/*.tflite
!model/runtime_manifest*.json
!model/class_labels*.json

# Generated logs/reports. Keep written Markdown summaries.
reports/*.csv
reports/*.json
reports/live_word_test_log_*
reports/live_log_comparison.*
!reports/*.md
!reports/fsl105_dataset_audit.json
!reports/fsl105_dataset_audit.csv
!reports/fsl105_split_manifest.csv
