!reports/activity_detector_v1_evaluation.json
!reports/fsl_rejection_calibration.json
!reports/autonomous_sprint_validation.json
!reports/android_fsl_integration_audit.json
reports/smoke/
android_dry_run/reports/evidence/
android_dry_run/reports/*.patch
android_dry_run/reports/*.INTERRUPTED_*.kt

# Keep only completed experimental model artifacts; smoke outputs are local QA.
model/experimental/smoke/

